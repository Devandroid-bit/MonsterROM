From a997b8ee71e3e03afca2552c17971cf6910a9491 Mon Sep 17 00:00:00 2001
From: ditternation <ditternation@localhost>
Date: Fri, 19 Jun 2026 00:35:00 +0200
Subject: [PATCH] Handle missing original focal length metadata

The Exynos 2100 camera HAL does not publish the newer
samsung.android.lens.info.originalFocalLengthIn35mmFilm vendor tag.
Android 17 Samsung Camera unconditionally unboxes that tag while building
its zoom-to-focal-length table, crashing Camera.onCreate when it is null.

Use 0.0 as the optional table value when the vendor metadata is absent.
The table is advisory and this preserves all camera IDs and zoom features.
---
 smali_classes2/r8/d.smali | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/smali_classes2/r8/d.smali b/smali_classes2/r8/d.smali
index b077bd08d..0d7e45a8d 100644
--- a/smali_classes2/r8/d.smali
+++ b/smali_classes2/r8/d.smali
@@ -624,4 +624,11 @@
     :cond_0
     iget-object p0, p0, Lcom/samsung/android/camera/core2/local/capability/LensCapability;->g:Ljava/lang/Integer;
 
+    if-nez p0, :cond_1
+
+    const/4 p0, 0x0
+
+    return p0
+
+    :cond_1
     invoke-virtual {p0}, Ljava/lang/Integer;->intValue()I
-- 
2.52.0
